extra/

# data: ignore the large videos/frames, but keep the small files needed to
# reproduce training/evaluation (metadata labels + the 850/150 subset split)
data/*
!data/metadata/
data/metadata/*
!data/metadata/dish_metadata_cafe1.csv
!data/splits/
data/splits/*
!data/splits/subset_train_ids.txt
